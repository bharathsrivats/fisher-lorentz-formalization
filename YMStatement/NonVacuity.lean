import Mathlib
import YMStatement.GaugeGroup

/-!
# Non-vacuity of the gauge-group predicate (attack A1)

The main statement quantifies over groups satisfying `HasSimpleLieAlgebra`. If no group satisfied
it, the statement would be vacuously true (the failure mode found in the LeanDojo Hodge file).
We exhibit one: the subgroup of `U(3)` generated by exponentials of real skew-symmetric matrices
(mathematically `SO(3)`). Read off its defining representation, its Lie algebra is `so(3)`, which we
prove simple.

Not proved here: that this subgroup is compact and connected (it equals `SO(3)`); the main statement
also requires those properties through instance arguments.
-/

noncomputable section

namespace YMStatement

open scoped Matrix

attribute [local instance 100] LieRing.ofAssociativeRing

/-- Complex `3 × 3` matrices. -/
abbrev M3 := Matrix (Fin 3) (Fin 3) ℂ

/-- Real skew-symmetric matrices: `Xᴴ = Xᵀ` (real entries) and `Xᴴ = -X` (skew). -/
def so3Carrier : Set M3 := {X | Xᴴ = Xᵀ ∧ Xᴴ = -X}

theorem so3Carrier_smul {X : M3} (hX : X ∈ so3Carrier) (t : ℝ) : t • X ∈ so3Carrier := by
  obtain ⟨h1, h2⟩ := hX
  refine ⟨?_, ?_⟩
  · rw [Matrix.conjTranspose_smul, Matrix.transpose_smul, h1, star_trivial]
  · rw [Matrix.conjTranspose_smul, h2, star_trivial, smul_neg]

/-- `so(3)` as a real Lie subalgebra of `M₃(ℂ)` with the commutator bracket. -/
def so3 : LieSubalgebra ℝ M3 where
  carrier := so3Carrier
  add_mem' := by
    intro X Y hX hY
    obtain ⟨hX1, hX2⟩ := hX
    obtain ⟨hY1, hY2⟩ := hY
    refine ⟨?_, ?_⟩
    · rw [Matrix.conjTranspose_add, Matrix.transpose_add, hX1, hY1]
    · rw [Matrix.conjTranspose_add, hX2, hY2, neg_add]
  zero_mem' := ⟨by simp, by simp⟩
  smul_mem' := by
    intro t X hX
    exact so3Carrier_smul hX t
  lie_mem' := by
    intro X Y hX hY
    obtain ⟨hX1, hX2⟩ := hX
    obtain ⟨hY1, hY2⟩ := hY
    refine ⟨?_, ?_⟩
    · rw [Ring.lie_def, Matrix.conjTranspose_sub, Matrix.transpose_sub, Matrix.conjTranspose_mul,
        Matrix.conjTranspose_mul, Matrix.transpose_mul, Matrix.transpose_mul, hX1, hY1]
    · rw [Ring.lie_def, Matrix.conjTranspose_sub, Matrix.conjTranspose_mul,
        Matrix.conjTranspose_mul, hX2, hY2]
      noncomm_ring

def L1 : M3 := !![0, 0, 0; 0, 0, -1; 0, 1, 0]
def L2 : M3 := !![0, 0, 1; 0, 0, 0; -1, 0, 0]
def L3 : M3 := !![0, -1, 0; 1, 0, 0; 0, 0, 0]

theorem L1_mem : L1 ∈ so3Carrier := by
  refine ⟨?_, ?_⟩ <;> ext i j <;> fin_cases i <;> fin_cases j <;> simp [L1]

theorem L2_mem : L2 ∈ so3Carrier := by
  refine ⟨?_, ?_⟩ <;> ext i j <;> fin_cases i <;> fin_cases j <;> simp [L2]

theorem L3_mem : L3 ∈ so3Carrier := by
  refine ⟨?_, ?_⟩ <;> ext i j <;> fin_cases i <;> fin_cases j <;> simp [L3]

theorem L1L2 : L1 * L2 - L2 * L1 = L3 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [L1, L2, L3, Matrix.mul_apply, Fin.sum_univ_three]

theorem L2L3 : L2 * L3 - L3 * L2 = L1 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [L1, L2, L3, Matrix.mul_apply, Fin.sum_univ_three]

theorem L3L1 : L3 * L1 - L1 * L3 = L2 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [L1, L2, L3, Matrix.mul_apply, Fin.sum_univ_three]

theorem so3_entries {X : M3} (hX : X ∈ so3Carrier) :
    (∀ i j, X i j = ((X i j).re : ℂ)) ∧ (∀ i j, X i j = -X j i) := by
  obtain ⟨h1, h2⟩ := hX
  have hs : ∀ i j, star (X i j) = X i j := by
    intro i j
    have h := congrFun (congrFun h1 j) i
    rwa [Matrix.conjTranspose_apply, Matrix.transpose_apply] at h
  have hre : ∀ i j, X i j = ((X i j).re : ℂ) := by
    intro i j
    have him : (X i j).im = 0 := by
      have h := congrArg Complex.im (hs i j)
      simp only [Complex.star_def, Complex.conj_im] at h
      linarith
    exact Complex.ext (by simp) (by simp [him])
  refine ⟨hre, fun i j => ?_⟩
  have h := congrFun (congrFun h2 j) i
  rw [Matrix.conjTranspose_apply, Matrix.neg_apply] at h
  rw [← hs i j, h]

theorem so3_decomp {X : M3} (hX : X ∈ so3Carrier) :
    X = (X 2 1).re • L1 + (X 0 2).re • L2 + (X 1 0).re • L3 := by
  obtain ⟨hre, hsk⟩ := so3_entries hX
  have hd : ∀ i, X i i = 0 := fun i => by
    have h := hsk i i
    have h2 : (2 : ℂ) * X i i = 0 := by linear_combination h
    simpa using h2
  have e01 : X 0 1 = -((X 1 0).re : ℂ) := by rw [hsk 0 1, ← hre 1 0]
  have e12 : X 1 2 = -((X 2 1).re : ℂ) := by rw [hsk 1 2, ← hre 2 1]
  have e20 : X 2 0 = -((X 0 2).re : ℂ) := by rw [hsk 2 0, ← hre 0 2]
  have e10 := hre 1 0
  have e21 := hre 2 1
  have e02 := hre 0 2
  ext i j
  fin_cases i <;> fin_cases j <;> simp [L1, L2, L3, hd, e01, e12, e20] <;>
    first | exact e10 | exact e21 | exact e02 | exact e10.symm | exact e21.symm | exact e02.symm

def l1 : so3 := ⟨L1, L1_mem⟩
def l2 : so3 := ⟨L2, L2_mem⟩
def l3 : so3 := ⟨L3, L3_mem⟩

theorem lie_l1_l2 : ⁅l1, l2⁆ = l3 :=
  Subtype.ext (by first | exact L1L2 | (simp only [LieSubalgebra.coe_bracket, Ring.lie_def]; exact L1L2))

theorem lie_l2_l3 : ⁅l2, l3⁆ = l1 :=
  Subtype.ext (by first | exact L2L3 | (simp only [LieSubalgebra.coe_bracket, Ring.lie_def]; exact L2L3))

theorem lie_l3_l1 : ⁅l3, l1⁆ = l2 :=
  Subtype.ext (by first | exact L3L1 | (simp only [LieSubalgebra.coe_bracket, Ring.lie_def]; exact L3L1))

theorem lie_l1_l3 : ⁅l1, l3⁆ = -l2 := by rw [← lie_skew, lie_l3_l1]
theorem lie_l2_l1 : ⁅l2, l1⁆ = -l3 := by rw [← lie_skew, lie_l1_l2]
theorem lie_l3_l2 : ⁅l3, l2⁆ = -l1 := by rw [← lie_skew, lie_l2_l3]

theorem so3_decomp' (y : so3) :
    y = ((y : M3) 2 1).re • l1 + ((y : M3) 0 2).re • l2 + ((y : M3) 1 0).re • l3 := by
  apply Subtype.ext
  exact so3_decomp y.2

theorem double_comm_L1 (a b c : ℝ) :
    (a • L1 + b • L2 + c • L3) + (L1 * (L1 * (a • L1 + b • L2 + c • L3) -
      (a • L1 + b • L2 + c • L3) * L1) - (L1 * (a • L1 + b • L2 + c • L3) -
      (a • L1 + b • L2 + c • L3) * L1) * L1) = a • L1 := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [L1, L2, L3, Matrix.mul_apply, Fin.sum_univ_three] <;> ring

theorem add_lie_lie_l1 (x : so3) : x + ⁅l1, ⁅l1, x⁆⁆ = ((x : M3) 2 1).re • l1 := by
  apply Subtype.ext
  have hd := so3_decomp x.2
  change (x : M3) + (L1 * (L1 * (x : M3) - (x : M3) * L1) - (L1 * (x : M3) - (x : M3) * L1) * L1) =
    ((x : M3) 2 1).re • L1
  conv_lhs => rw [hd]
  exact double_comm_L1 _ _ _

theorem double_comm_L2 (a b c : ℝ) :
    (a • L1 + b • L2 + c • L3) + (L2 * (L2 * (a • L1 + b • L2 + c • L3) -
      (a • L1 + b • L2 + c • L3) * L2) - (L2 * (a • L1 + b • L2 + c • L3) -
      (a • L1 + b • L2 + c • L3) * L2) * L2) = b • L2 := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [L1, L2, L3, Matrix.mul_apply, Fin.sum_univ_three] <;> ring

theorem add_lie_lie_l2 (x : so3) : x + ⁅l2, ⁅l2, x⁆⁆ = ((x : M3) 0 2).re • l2 := by
  apply Subtype.ext
  have hd := so3_decomp x.2
  change (x : M3) + (L2 * (L2 * (x : M3) - (x : M3) * L2) - (L2 * (x : M3) - (x : M3) * L2) * L2) =
    ((x : M3) 0 2).re • L2
  conv_lhs => rw [hd]
  exact double_comm_L2 _ _ _

theorem double_comm_L3 (a b c : ℝ) :
    (a • L1 + b • L2 + c • L3) + (L3 * (L3 * (a • L1 + b • L2 + c • L3) -
      (a • L1 + b • L2 + c • L3) * L3) - (L3 * (a • L1 + b • L2 + c • L3) -
      (a • L1 + b • L2 + c • L3) * L3) * L3) = c • L3 := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [L1, L2, L3, Matrix.mul_apply, Fin.sum_univ_three] <;> ring

theorem add_lie_lie_l3 (x : so3) : x + ⁅l3, ⁅l3, x⁆⁆ = ((x : M3) 1 0).re • l3 := by
  apply Subtype.ext
  have hd := so3_decomp x.2
  change (x : M3) + (L3 * (L3 * (x : M3) - (x : M3) * L3) - (L3 * (x : M3) - (x : M3) * L3) * L3) =
    ((x : M3) 1 0).re • L3
  conv_lhs => rw [hd]
  exact double_comm_L3 _ _ _

theorem neg_mem_iff' {I : LieIdeal ℝ so3} {v : so3} (h : -v ∈ I) : v ∈ I := by
  have := I.neg_mem h
  rwa [neg_neg] at this

theorem basis_of_l1 {I : LieIdeal ℝ so3} (h1 : l1 ∈ I) : l1 ∈ I ∧ l2 ∈ I ∧ l3 ∈ I := by
  have h3 : l3 ∈ I := neg_mem_iff' (by rw [← lie_l2_l1]; exact I.lie_mem h1)
  have h2 : l2 ∈ I := by rw [← lie_l3_l1]; exact I.lie_mem h1
  exact ⟨h1, h2, h3⟩

theorem basis_of_l2 {I : LieIdeal ℝ so3} (h2 : l2 ∈ I) : l1 ∈ I ∧ l2 ∈ I ∧ l3 ∈ I := by
  have h3 : l3 ∈ I := by rw [← lie_l1_l2]; exact I.lie_mem h2
  have h1 : l1 ∈ I := neg_mem_iff' (by rw [← lie_l3_l2]; exact I.lie_mem h2)
  exact ⟨h1, h2, h3⟩

theorem basis_of_l3 {I : LieIdeal ℝ so3} (h3 : l3 ∈ I) : l1 ∈ I ∧ l2 ∈ I ∧ l3 ∈ I := by
  have h2 : l2 ∈ I := neg_mem_iff' (by rw [← lie_l1_l3]; exact I.lie_mem h3)
  have h1 : l1 ∈ I := by rw [← lie_l2_l3]; exact I.lie_mem h3
  exact ⟨h1, h2, h3⟩

theorem unit_mem {I : LieIdeal ℝ so3} {r : ℝ} {v : so3} (hr : r ≠ 0) (h : r • v ∈ I) : v ∈ I := by
  have := I.smul_mem r⁻¹ h
  rwa [smul_smul, inv_mul_cancel₀ hr, one_smul] at this

/-- `so(3)` is a simple real Lie algebra. -/
theorem so3_isSimple : LieAlgebra.IsSimple ℝ so3 := by
  refine ⟨fun I => ?_, ?_⟩
  · by_cases hI : I = ⊥
    · exact Or.inl hI
    · right
      have hex : ∃ x ∈ I, x ≠ 0 := by
        by_contra hcon
        push_neg at hcon
        apply hI
        rw [eq_bot_iff]
        intro x hx
        rw [LieSubmodule.mem_bot]
        exact hcon x hx
      obtain ⟨x, hxI, hx0⟩ := hex
      have hm1 : ((x : M3) 2 1).re • l1 ∈ I := by
        rw [← add_lie_lie_l1 x]; exact I.add_mem hxI (I.lie_mem (I.lie_mem hxI))
      have hm2 : ((x : M3) 0 2).re • l2 ∈ I := by
        rw [← add_lie_lie_l2 x]; exact I.add_mem hxI (I.lie_mem (I.lie_mem hxI))
      have hm3 : ((x : M3) 1 0).re • l3 ∈ I := by
        rw [← add_lie_lie_l3 x]; exact I.add_mem hxI (I.lie_mem (I.lie_mem hxI))
      have hbasis : l1 ∈ I ∧ l2 ∈ I ∧ l3 ∈ I := by
        by_cases ha : ((x : M3) 2 1).re = 0
        · by_cases hb : ((x : M3) 0 2).re = 0
          · by_cases hc : ((x : M3) 1 0).re = 0
            · exfalso
              apply hx0
              rw [so3_decomp' x, ha, hb, hc]
              simp
            · exact basis_of_l3 (unit_mem hc hm3)
          · exact basis_of_l2 (unit_mem hb hm2)
        · exact basis_of_l1 (unit_mem ha hm1)
      obtain ⟨h1, h2, h3⟩ := hbasis
      rw [eq_top_iff]
      intro y _
      rw [so3_decomp' y]
      exact I.add_mem (I.add_mem (I.smul_mem _ h1) (I.smul_mem _ h2)) (I.smul_mem _ h3)
  · intro hab
    have h := hab.trivial l1 l2
    rw [lie_l1_l2] at h
    have hc : L3 = 0 := congrArg Subtype.val h
    have h10 := congrFun (congrFun hc 1) 0
    simp [L3] at h10

/-- If `exp (t • A) = exp (t • B)` for all real `t`, then `A = B`. -/
theorem eq_of_exp_smul_eq {n : ℕ} {A B : Matrix (Fin n) (Fin n) ℂ}
    (h : ∀ t : ℝ, NormedSpace.exp (t • A) = NormedSpace.exp (t • B)) : A = B := by
  letI : NormedRing (Matrix (Fin n) (Fin n) ℂ) := Matrix.linftyOpNormedRing
  letI : NormedAlgebra ℝ (Matrix (Fin n) (Fin n) ℂ) := Matrix.linftyOpNormedAlgebra
  have d1 : HasDerivAt (fun t : ℝ => NormedSpace.exp (t • A))
      (A * NormedSpace.exp ((0 : ℝ) • A)) 0 := hasDerivAt_exp_smul_const' (𝕂 := ℝ) A (0 : ℝ)
  have d2 : HasDerivAt (fun t : ℝ => NormedSpace.exp (t • B))
      (B * NormedSpace.exp ((0 : ℝ) • B)) 0 := hasDerivAt_exp_smul_const' (𝕂 := ℝ) B (0 : ℝ)
  have heq : (fun t : ℝ => NormedSpace.exp (t • A)) = fun t : ℝ => NormedSpace.exp (t • B) :=
    funext h
  rw [heq] at d1
  simpa [NormedSpace.exp_zero] using d1.unique d2

theorem exp_mem_unitary_of_so3 {X : M3} (hX : X ∈ so3Carrier) :
    NormedSpace.exp X ∈ unitary M3 := by
  have hstar : star (NormedSpace.exp X) = (NormedSpace.exp X)⁻¹ := by
    rw [Matrix.star_eq_conjTranspose, ← Matrix.exp_conjTranspose, hX.2, Matrix.exp_neg]
  have hunit : IsUnit (NormedSpace.exp X).det :=
    (Matrix.isUnit_iff_isUnit_det _).mp (Matrix.isUnit_exp X)
  rw [Unitary.mem_iff, hstar]
  exact ⟨Matrix.nonsing_inv_mul _ hunit, Matrix.mul_nonsing_inv _ hunit⟩

/-- Generators: exponentials of real skew-symmetric matrices, as elements of `U(3)`. -/
def so3Generators : Set (Matrix.unitaryGroup (Fin 3) ℂ) :=
  {u | ∃ X ∈ so3Carrier, (u : M3) = NormedSpace.exp X}

/-- The subgroup of `U(3)` they generate (mathematically `SO(3)`). -/
def SO3gen : Subgroup (Matrix.unitaryGroup (Fin 3) ℂ) := Subgroup.closure so3Generators

/-- The defining representation of `SO3gen` on `ℂ³`. -/
def rhoSO3 : FaithfulUnitaryRep SO3gen 3 where
  toHom := SO3gen.subtype
  continuous_toHom := continuous_subtype_val
  injective_toHom := Subtype.val_injective

theorem conjTranspose_eq_transpose_of_mem {u : Matrix.unitaryGroup (Fin 3) ℂ} (hu : u ∈ SO3gen) :
    (u : M3)ᴴ = (u : M3)ᵀ := by
  induction hu using Subgroup.closure_induction with
  | mem u hu =>
    obtain ⟨X, hX, hux⟩ := hu
    rw [hux, ← Matrix.exp_conjTranspose, ← Matrix.exp_transpose, hX.1]
  | one =>
    change (1 : M3)ᴴ = (1 : M3)ᵀ
    simp
  | mul u v _ _ hu hv =>
    change ((u : M3) * (v : M3))ᴴ = ((u : M3) * (v : M3))ᵀ
    rw [Matrix.conjTranspose_mul, Matrix.transpose_mul, hu, hv]
  | inv u _ hu =>
    change (star (u : M3))ᴴ = (star (u : M3))ᵀ
    rw [Matrix.star_eq_conjTranspose, Matrix.conjTranspose_conjTranspose]
    ext i j
    have h := congrFun (congrFun hu j) i
    simp only [Matrix.conjTranspose_apply, Matrix.transpose_apply] at h ⊢
    exact h.symm

theorem rhoSO3_lieAlgebraCarrier : rhoSO3.lieAlgebraCarrier = so3Carrier := by
  ext X
  constructor
  · intro hX
    have key : ∀ t : ℝ, NormedSpace.exp (t • X) ∈ unitary M3 ∧
        (NormedSpace.exp (t • X))ᴴ = (NormedSpace.exp (t • X))ᵀ := by
      intro t
      obtain ⟨g, hg⟩ := hX t
      have hg' : ((g : Matrix.unitaryGroup (Fin 3) ℂ) : M3) = NormedSpace.exp (t • X) := hg
      rw [← hg']
      exact ⟨(g : Matrix.unitaryGroup (Fin 3) ℂ).2, conjTranspose_eq_transpose_of_mem g.2⟩
    have hct : ∀ t : ℝ, (t • X)ᴴ = t • Xᴴ := fun t => by
      rw [Matrix.conjTranspose_smul, star_trivial]
    have htt : ∀ t : ℝ, (t • X)ᵀ = t • Xᵀ := fun t => Matrix.transpose_smul t X
    refine ⟨eq_of_exp_smul_eq fun t => ?_, eq_of_exp_smul_eq fun t => ?_⟩
    · rw [← hct, ← htt, Matrix.exp_conjTranspose, Matrix.exp_transpose]
      exact (key t).2
    · obtain ⟨hu, -⟩ := key t
      have hsm : (NormedSpace.exp (t • X))ᴴ * NormedSpace.exp (t • X) = 1 := by
        have := (Unitary.mem_iff.mp hu).1
        rwa [Matrix.star_eq_conjTranspose] at this
      have hinv := Matrix.inv_eq_left_inv hsm
      rw [← hct, Matrix.exp_conjTranspose, ← hinv, ← Matrix.exp_neg, smul_neg]
  · intro hX t
    exact ⟨⟨⟨NormedSpace.exp (t • X), exp_mem_unitary_of_so3 (so3Carrier_smul hX t)⟩,
      Subgroup.subset_closure ⟨t • X, so3Carrier_smul hX t, rfl⟩⟩, rfl⟩

/-- **Non-vacuity of the gauge-group predicate.** -/
theorem hasSimpleLieAlgebra_SO3gen : HasSimpleLieAlgebra SO3gen :=
  ⟨3, rhoSO3, so3, by rw [rhoSO3_lieAlgebraCarrier]; rfl, so3_isSimple⟩

end YMStatement
